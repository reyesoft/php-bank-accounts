<?xml version="1.0"?>
<ruleset name="Custom PHPMD rule set for bank-accounts project"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        Custom PHPMD rule set for bank-accounts project
    </description>

    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml"/>

    <!-- Code Size Rules -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="10"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <!-- PHPMD uses 'reportLevel' for NPathComplexity, not 'minimum'. Assuming 'reportLevel' was intended. -->
            <property name="reportLevel" value="200"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="80"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="15"/>
            <property name="ignorepattern" value="(^(set|get|test))i"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="25"/>
            <property name="ignorepattern" value="(^(set|get|test))i"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessivePublicCount">
        <properties>
            <property name="maximum" value="15"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="50"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <!-- PHPMD uses 'maximum' for ExcessiveParameterList. -->
            <property name="maximum" value="10"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="250"/>
        </properties>
    </rule>
    <!-- Include other default codesize rules that were not specifically customized above -->
    <rule ref="rulesets/codesize.xml">
        <exclude name="CyclomaticComplexity"/>
        <exclude name="NPathComplexity"/>
        <exclude name="ExcessiveMethodLength"/>
        <exclude name="TooManyPublicMethods"/>
        <exclude name="TooManyMethods"/>
        <exclude name="ExcessivePublicCount"/>
        <exclude name="ExcessiveClassComplexity"/>
        <exclude name="ExcessiveParameterList"/>
        <exclude name="ExcessiveClassLength"/>
    </rule>

    <!-- Controversial Rules -->
    <rule ref="rulesets/controversial.xml"/>

    <!-- Design Rules -->
    <!--
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="15"/>
        </properties>
    </rule>
    -->
    <!-- <rule ref="rulesets/design.xml/NumberOfChildren"> -->
        <!-- Attempting without properties to see if the rule itself is the issue -->
    <!-- </rule> -->
    <!-- <rule ref="rulesets/design.xml/DepthOfInheritance"> -->
        <!-- Attempting without properties to see if the rule itself is the issue -->
    <!-- </rule> -->
    <!--
    <rule ref="rulesets/design.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="20"/>
        </properties>
    </rule>
    -->
    <!-- Include other default design rules that were not specifically customized above -->
    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects"/>
        <exclude name="NumberOfChildren"/>
        <exclude name="DepthOfInheritance"/>
        <exclude name="TooManyFields"/>
    </rule>

    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="3"/>
            <property name="exceptions" value="id,i,j,k,v,e,f,fp"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="25"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortClassName">
        <properties>
            <property name="minimum" value="3"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongClassName">
        <properties>
            <property name="maximum" value="60"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ConstructorWithNameAsEnclosingClass"/>
    <rule ref="rulesets/naming.xml/ConstantNamingConventions"/>
    <rule ref="rulesets/naming.xml/BooleanGetMethodName"/>
    <!-- Include other default naming rules that were not specifically customized above -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
        <exclude name="ShortClassName"/>
        <exclude name="LongClassName"/>
        <exclude name="ConstructorWithNameAsEnclosingClass"/>
        <exclude name="ConstantNamingConventions"/>
        <exclude name="BooleanGetMethodName"/>
    </rule>

    <!-- Unused Code Rules -->
    <rule ref="rulesets/unusedcode.xml"/>

</ruleset>
